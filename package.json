{
  "name": "guest-parking-booking",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app components db lib tests vite.config.ts vitest.config.ts drizzle.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "verify": "npm run check && npm run test:coverage && npm run build && npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.55.0",
    "react": "^19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "shadcn": "4.21.4",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "0.31.11",
    "oxfmt": "0.72.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "type": "module"
}
